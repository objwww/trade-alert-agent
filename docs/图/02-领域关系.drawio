yle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#557aaf" source="review" target="report"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1507" y="846" /><mxPoint as="targetPoint" x="877" y="1015" /><Array as="points"><mxPoint x="1507" y="944" /><mxPoint x="877" y="944" /></Array></mxGeometry></mxCell><mxCell id="test-investigation" value="关联 Run，独立于调查结论" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#557aaf;dashed=1" source="test" target="run"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1087" y="846" /><mxPoint as="targetPoint" x="667" y="292" /><Array as="points"><mxPoint x="1087" y="888" /><mxPoint x="450" y="888" /><mxPoint x="450" y="315" /><mxPoint x="667" y="315" /></Array></mxGeometry></mxCell><mxCell id="note-0" value="业务场景与调查契约｜领域关系与一致性边界" vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;align=left;fontColor=#173253"><mxGeometry as="geometry" x="45" y="17" width="1710" height="36" /></mxCell><mxCell id="note-1" value="目标一设计 0.1 · 关联基数图 · 连线表达引用关系，不表示远程调用" vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;align=left;fontColor=#687991"><mxGeometry as="geometry" x="45" y="67" width="1710" height="36" /></mxCell><mxCell id="note-2" value="必要短事务：Task 状态＋正式结果＋Finding 关联＋Run 版本共同提交；外部 Evidence 大对象另有 PENDING → READY 边界。" vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;align=left;fontColor=#52677f"><mxGeometry as="geometry" x="75" y="1165" width="1710" height="36" /></mxCell><mxCell id="note-3" value="Cardinality 为概念关联：正式物理表、索引、保留期限及容量在后续目标验证；Note／Context 是可重建投影，不替代上述真源。" vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;align=left;fontColor=#52677f"><mxGeometry as="geometry" x="75" y="1200" width="1710" height="36" /></mxCell></root></mxGraphModel></diagram></mxfile>