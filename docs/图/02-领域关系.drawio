<mxfile host="app.diagrams.net" type="device"><diagram name="业务场景与调查契约｜领域关系与一致性边界" id="02-领域关系"><mxGraphModel page="1" pageWidth="1800" pageHeight="1260" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="incident" value="Incident 事件&lt;br/&gt;业务异常 / 告警关联&lt;br/&gt;公开编号 / 显式选择报告" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#d5dfeb;fontColor=#173253;fontSize=16;"><mxGeometry as="geometry" x="75" y="170" width="345" height="122" /></mxCell><mxCell id="run" value="InvestigationRun 调查&lt;br/&gt;生命周期＋阶段＋独立结论&lt;br/&gt;预算 / Owner / Epoch / 版本" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#d5dfeb;fontColor=#173253;fontSize=16;"><mxGeometry as="geometry" x="495" y="170" width="345" height="122" /></mxCell><mxCell id="task" value="InvestigationTask 任务&lt;br/&gt;不可变目标 / 范围 / 完成标准&lt;br/&gt;Ready 资格动态计算" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#d5dfeb;fontColor=#173253;fontSize=16;"><mxGeometry as="geometry" x="915" y="170" width="345" height="122" /></mxCell><mxCell id="attempt" value="TaskAttempt 执行尝试&lt;br/&gt;每次重试与接管有独立身份&lt;br/&gt;旧尝试不恢复执行权" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#d5dfeb;fontColor=#173253;fontSize=16;"><mxGeometry as="geometry" x="1335" y="170" width="345" height="122" /></mxCell><mxCell id="plan" value="PlanRevision／Membership&lt;br/&gt;不可变 DAG 及有效任务集合&lt;br/&gt;可沿用旧任务，不只比创建版本" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef8f5;strokeColor=#d5dfeb;fontColor=#173253;fontSize=16;"><mxGeometry as="geometry" x="75" y="420" width="345" height="136" /></mxCell><mxCell id="result" value="TaskExecutionResult&lt;br/&gt;执行状态 / 覆盖 / 假设结论&lt;br/&gt;同键同内容幂等提交" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef8f5;strokeColor=#d5dfeb;fontColor=#173253;fontSize=16;"><mxGeometry as="geometry" x="495" y="420" width="345" height="136" /></mxCell><mxCell id="finding" value="Finding 调查发现&lt;br/&gt;命题 / 支持 / 反证 / 缺口&lt;br/&gt;有引用不等于因果成立" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef8f5;strokeColor=#d5dfeb;fontColor=#173253;fontSize=16;"><mxGeometry as="geometry" x="915" y="420" width="345" height="136" /></mxCell><mxCell id="evidence" value="Evidence 原始证据&lt;br/&gt;来源 / 窗口 / 完整性 / READY&lt;br/&gt;精确 locator 与当前读取授权" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef8f5;strokeColor=#d5dfeb;fontColor=#173253;fontSize=16;"><mxGeometry as="geometry" x="1335" y="420" width="345" height="136" /></mxCell><mxCell id="scenario" value="ScenarioVersion 场景版本&lt;br/&gt;中文场景 / 条件 / 证据要求&lt;br/&gt;模型不可读评测真值" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8eb;strokeColor=#d5dfeb;fontColor=#173253;fontSize=16;"><mxGeometry as="geometry" x="75" y="710" width="345" height="136" /></mxCell><mxCell id="fault" value="FaultTrigger 故障触发&lt;br/&gt;申请 / 执行 / 效果 / 独立恢复&lt;br/&gt;注入完成不等于业务恢复" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8eb;strokeColor=#d5dfeb;fontColor=#173253;fontSize=16;"><mxGeometry as="geometry" x="495" y="710" width="345" height="136" /></mxCell><mxCell id="test" value="TestRun 测试记录&lt;br/&gt;发起 / 执行账号 / 中文功能&lt;br/&gt;关联故障、调查、截图及判定" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8eb;strokeColor=#d5dfeb;fontColor=#173253;fontSize=16;"><mxGeometry as="geometry" x="915" y="710" width="345" height="136" /></mxCell><mxCell id="review" value="ReviewResult／ReviewIssue&lt;br/&gt;绑定候选与被审状态版本&lt;br/&gt;审核决定 / 反证 / 补证缺口" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8eb;strokeColor=#d5dfeb;fontColor=#173253;fontSize=16;"><mxGeometry as="geometry" x="1335" y="710" width="345" height="136" /></mxCell><mxCell id="report" value="RCAReport／Incident.selectedReportRef&lt;br/&gt;报告按 Run 独立保留；当前报告通过授权命令与 Incident 版本选择&lt;br/&gt;不采用多个 Run 最后写入覆盖；根因接受、受控验证、业务恢复分开" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1edff;strokeColor=#b3a2d9;fontColor=#173253;fontSize=16;"><mxGeometry as="geometry" x="495" y="1015" width="765" height="113" /></mxCell><mxCell id="incident-runs" value="1:0..N" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#557aaf" source="incident" target="run"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="420" y="230" /><mxPoint as="targetPoint" x="495" y="230" /><Array as="points" /></mxGeometry></mxCell><mxCell id="run-tasks" value="1:0..N" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#557aaf" source="run" target="task"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="840" y="230" /><mxPoint as="targetPoint" x="915" y="230" /><Array as="points" /></mxGeometry></mxCell><mxCell id="task-attempts" value="1:0..N" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#557aaf" source="task" target="attempt"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1260" y="230" /><mxPoint as="targetPoint" x="1335" y="230" /><Array as="points" /></mxGeometry></mxCell><mxCell id="run-plan" value="1:0..N 计划版本" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#557aaf" source="run" target="plan"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="667" y="292" /><mxPoint as="targetPoint" x="247" y="420" /><Array as="points"><mxPoint x="667" y="345" /><mxPoint x="247" y="345" /></Array></mxGeometry></mxCell><mxCell id="task-result" value="任务的正式结果" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#557aaf" source="task" target="result"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1087" y="292" />